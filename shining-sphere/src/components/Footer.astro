---
interface Props {
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <div class="footer-logo">
        <span class="cookie-emoji">🍪</span>
        <span class="footer-title">Soft Cookies</span>
      </div>
      <p class="footer-tagline">
        Micro-bakehouse artesanal. Horneadas exclusivas por tanda con ingredientes de alta calidad en Tierras Altas, Bugaba y David.
      </p>
    </div>

    <div class="footer-links-grid">
      <div class="footer-col">
        <h5 class="col-title">Zonas de Entrega</h5>
        <ul class="col-list">
          <li>Tierras Altas (Puntos céntricos)</li>
          <li>Bugaba (Entregas programadas)</li>
          <li>David (Pickup & Delivery)</li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 class="col-title">Contacto & Pedidos</h5>
        <ul class="col-list">
          <li>
            <a href="https://instagram.com/softcookies.pty" target="_blank" rel="noopener noreferrer" class="link-item">
              Instagram: @softcookies.pty
            </a>
          </li>
          <li>
            <a href="https://instagram.com/chelsea.mhm" target="_blank" rel="noopener noreferrer" class="link-item">
              Chef: @chelsea.mhm
            </a>
          </li>
          <li>WhatsApp: +507 6000-0000</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Soft Cookies TANDAS. Todos los derechos reservados.</p>
      <p class="handmade-note">Hecho con amor y mantequilla pura 🧈</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface-container);
    border-top: 1px solid var(--color-border-subtle);
    padding: 3rem 0 2rem;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-brand {
    max-width: 460px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .cookie-emoji {
    font-size: 1.5rem;
  }

  .footer-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-on-surface);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .footer-links-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .col-title {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-secondary-dark);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--color-on-surface-variant);
  }

  .link-item {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .link-item:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-on-surface-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .handmade-note {
    font-weight: 600;
    color: var(--color-secondary);
  }
</style>
