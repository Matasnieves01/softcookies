---
interface Props {
  chefHandle?: string;
  locationText?: string;
}

const {
  chefHandle = "@chelsea.mhm",
  locationText = "Tierras Altas, Bugaba y David"
} = Astro.props;
---

<section class="hero-greeting" aria-labelledby="welcome-title">
  <div class="container">
    <div class="greeting-card">
      <h1 id="welcome-title" class="welcome-heading">¡Bienvenido a Soft Cookies!</h1>
      
      <p class="welcome-description">
        Horneadas exclusivas por tanda y promociones especiales de la chef <a href={`https://instagram.com/${chefHandle.replace('@', '')}`} class="chef-link" target="_blank" rel="noopener noreferrer">{chefHandle}</a> en {locationText}. Reserva tu cupo antes de que se agoten.
      </p>

      <div class="filter-chips-list" role="tablist" aria-label="Filtros de menú">
        <button class="chip-item chip-active" role="tab" aria-selected="true">
          <span class="chip-icon">🔥</span>
          <span>Promociones Activas</span>
        </button>

        <button class="chip-item" role="tab" aria-selected="false">
          <span class="chip-icon">📅</span>
          <span>Próximas Tandas</span>
        </button>

        <button class="chip-item" role="tab" aria-selected="false">
          <span class="chip-icon">⭐</span>
          <span>Favoritos</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-greeting {
    padding-top: 1.5rem;
    padding-bottom: 0.75rem;
  }

  .greeting-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s ease;
  }

  @media (min-width: 768px) {
    .greeting-card {
      padding: 2rem 2.25rem;
      border-radius: var(--radius-xl);
    }
  }

  .welcome-heading {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-on-surface);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.65rem;
  }

  @media (min-width: 640px) {
    .welcome-heading {
      font-size: 2.1rem;
    }
  }

  @media (min-width: 1024px) {
    .welcome-heading {
      font-size: 2.35rem;
    }
  }

  .welcome-description {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
    max-width: 820px;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 640px) {
    .welcome-description {
      font-size: 1rem;
    }
  }

  .chef-link {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(141, 75, 0, 0.3);
    transition: color 0.2s ease;
  }

  .chef-link:hover {
    color: var(--color-primary-hover);
  }

  .filter-chips-list {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .chip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 700;
    transition: all 0.2s ease;
    border: 1px solid var(--color-outline-variant);
    background-color: var(--color-surface-container-low);
    color: var(--color-on-surface-variant);
  }

  .chip-item:hover {
    background-color: var(--color-surface-container);
    border-color: var(--color-outline);
    transform: translateY(-1px);
  }

  .chip-active {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(141, 75, 0, 0.25);
  }

  .chip-active:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .chip-icon {
    font-size: 0.9rem;
  }
</style>
