---
interface Props {
  brandName?: string;
  badgeText?: string;
  instagramHandle?: string;
}

const {
  brandName = "Soft Cookies",
  badgeText,
  instagramHandle = "@softcookies.pty"
} = Astro.props;
---

<header class="navbar">
  <div class="container navbar-container">
    <a href="/" class="brand-group" aria-label="Ir al inicio de Soft Cookies">
      <div class="logo-avatar">
        <!-- SVG Cute Cookie Mascot -->
        <svg viewBox="0 0 100 100" class="cookie-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="45" fill="#f4b266" />
          <circle cx="50" cy="50" r="41" fill="#e89843" />
          <!-- Cookie texture bites & chips -->
          <circle cx="34" cy="34" r="7" fill="#4a2810" />
          <circle cx="68" cy="36" r="6" fill="#4a2810" />
          <circle cx="50" cy="62" r="7.5" fill="#4a2810" />
          <circle cx="28" cy="64" r="5" fill="#4a2810" />
          <circle cx="70" cy="66" r="5.5" fill="#4a2810" />
          <!-- Cute cheeks & smile -->
          <circle cx="38" cy="48" r="3" fill="#ffffff" opacity="0.8"/>
          <circle cx="62" cy="48" r="3" fill="#ffffff" opacity="0.8"/>
          <path d="M44 52 Q50 57 56 52" stroke="#4a2810" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="brand-info">
        <div class="title-row">
          <span class="brand-title">{brandName}</span>
          {badgeText && <span class="tandas-badge">{badgeText}</span>}
        </div>
        <span class="brand-handle">
          <svg viewBox="0 0 24 24" class="handle-icon" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14h2v2h-2v-2zm1.07-7.75l-.9.92C10.45 9.9 10 10.5 10 12h2c0-.55.45-1 1-1 .55 0 1-.45 1-1s-.45-1-1-1c-.55 0-1 .45-1 1H10c0-1.1.9-2 2-2s2 .9 2 2c0 .88-.72 1.45-1.93 1.75z"/>
          </svg>
          {instagramHandle}
        </span>
      </div>
    </a>

    <nav class="nav-actions" aria-label="Navegación principal">
      <a 
        href="https://instagram.com/softcookies.pty" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-pill btn-subtle"
        aria-label="Perfil de Instagram"
      >
        <span>IG</span>
      </a>

      <!-- Botón de Admin (Visible solo si la chef está autenticada) -->
      <a href="/admin" id="nav-admin-link" class="btn-pill btn-admin" style="display: none;">
        <span>👩‍🍳 Admin</span>
      </a>

      <!-- Botón de Cuenta -->
      <button type="button" id="nav-account-btn" class="btn-pill btn-account" aria-label="Abrir mi cuenta">
        <svg viewBox="0 0 24 24" class="action-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span id="nav-account-text">Mi Cuenta</span>
      </button>
    </nav>
  </div>
</header>

<script>
  import { getCurrentUser } from '../services/auth';

  const accountBtn = document.getElementById('nav-account-btn');
  const accountText = document.getElementById('nav-account-text');
  const adminLink = document.getElementById('nav-admin-link');

  function updateNavAuth() {
    const user = getCurrentUser();
    if (user) {
      if (accountText) {
        accountText.textContent = user.name.split(' ')[0] || 'Mi Cuenta';
      }
      if (adminLink) {
        adminLink.style.display = user.role === 'admin' ? 'inline-flex' : 'none';
      }
    } else {
      if (accountText) accountText.textContent = 'Mi Cuenta';
      if (adminLink) adminLink.style.display = 'none';
    }
  }

  // Initial check
  updateNavAuth();

  // Listen to auth changes
  window.addEventListener('softcookies:auth-changed', updateNavAuth);

  accountBtn?.addEventListener('click', () => {
    const user = getCurrentUser();
    if (user) {
      window.location.href = '/cuenta';
    } else {
      window.dispatchEvent(new CustomEvent('softcookies:open-auth'));
    }
  });
</script>

<style>
  .navbar {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: 0.85rem 0;
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(8px);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: transform 0.2s ease;
  }

  .brand-group:hover {
    transform: scale(1.01);
  }

  .logo-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(141, 75, 0, 0.15);
    background: #f8f3eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cookie-svg {
    width: 100%;
    height: 100%;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .brand-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-on-surface);
    letter-spacing: -0.01em;
  }

  .tandas-badge {
    background-color: #6a3443;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .brand-handle {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-on-surface-variant);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .handle-icon {
    width: 13px;
    height: 13px;
    opacity: 0.8;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 700;
    transition: all 0.2s ease;
    border: 1px solid var(--color-outline-variant);
    background-color: var(--color-surface-container-low);
    color: var(--color-on-surface-variant);
  }

  .btn-pill:hover {
    background-color: var(--color-surface-container);
    border-color: var(--color-outline);
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(74, 40, 16, 0.08);
  }

  .btn-subtle {
    min-width: 40px;
    padding: 0.45rem 0.75rem;
  }

  .btn-admin {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .btn-admin:hover {
    background-color: var(--color-primary-hover);
    color: #ffffff;
  }

  .btn-account {
    color: var(--color-secondary-dark);
  }

  .action-icon {
    width: 15px;
    height: 15px;
  }
</style>
