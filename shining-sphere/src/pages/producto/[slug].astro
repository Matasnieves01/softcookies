---
import Layout from '../../layouts/Layout.astro';
import TopBanner from '../../components/TopBanner.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getTandaBySlugFromDb, getCloudflareDb } from '../../services/tandas';
import type { Tanda } from '../../types';

export const prerender = false;

const { slug } = Astro.params;
const db = await getCloudflareDb(Astro.locals);
const tanda = slug ? await getTandaBySlugFromDb(db, slug) : null;

// Tanda data or fallback
const product: Tanda = tanda || {
  id: slug || 'not-found',
  slug: slug || 'not-found',
  name: 'Tanda no encontrada',
  subtitle: 'Esta tanda no está disponible o ya expiró',
  price: 6.50,
  unit: '/ porción',
  image: '/images/tarta-vasca.jpg',
  shortDescription: 'La tanda que buscas no se encuentra activa en este momento.',
  longDescription: 'Puedes revisar las tandas abiertas en la página principal para conocer los próximos horneados.',
  details: ['Elaboración artesanal', 'Cupos limitados por tanda'],
  ingredients: ['Receta especial de la Chef', 'Ingredientes seleccionados'],
  batchDates: 'Próximamente',
  deliveryDate: 'Próximamente',
  locations: ['Tierras Altas', 'Bugaba', 'David'],
  totalSlots: 20,
  reservedSlots: 0,
  isActive: false,
  createdAt: new Date().toISOString()
};

const isFound = tanda !== null;
const remainingSlots = Math.max(0, product.totalSlots - product.reservedSlots);
const isSoldOut = remainingSlots <= 0;
const details = product.details && product.details.length ? product.details : ['Elaboración artesanal por tanda limitada', 'Ingredientes frescos de alta calidad', 'Empaque protector individual para máxima frescura'];
const ingredients = product.ingredients && product.ingredients.length ? product.ingredients : ['Receta especial de la Chef Chelsea', 'Mantequilla pura', 'Ingredientes seleccionados'];
---

<Layout 
  title={`${product.name} | Reservas Soft Cookies`}
  description={product.shortDescription}
>
  <TopBanner text="• RESERVAS DE TANDA • CUPOS LIMITADOS" />
  <Navbar brandName="Soft Cookies" instagramHandle="@softcookies.pty" activeTab="tandas" />

  <main class="product-page">
    <div class="container">
      <!-- Breadcrumb / Back Link -->
      <nav class="breadcrumb-nav" aria-label="Navegación secundaria">
        <a href="/" class="back-link">
          <svg viewBox="0 0 24 24" class="back-arrow-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Volver al menú</span>
        </a>
      </nav>

      <div class="product-grid">
        <!-- Columna Izquierda: Información del Producto -->
        <section class="product-info-col" aria-label="Detalles del producto">
          <div class="main-image-card">
            <img 
              src={product.image} 
              alt={product.name} 
              class="product-main-img" 
            />
          </div>

          <header class="product-header-block">
            <h1 class="product-title">{product.name}</h1>
            <p class="product-subtitle">{product.subtitle}</p>
            
            <div class="price-badge-row">
              <span class="price-amount">${product.price.toFixed(2)}</span>
              <span class="price-unit">{product.unit}</span>
            </div>
          </header>

          <div class="info-card batch-schedule-card">
            <div class="schedule-item">
              <span class="schedule-icon">📅</span>
              <div>
                <strong>Fecha de entrega:</strong>
                <p>{product.batchDates}</p>
              </div>
            </div>

            <div class="schedule-item">
              <span class="schedule-icon">📍</span>
              <div>
                <strong>Zonas de entrega:</strong>
                <p>{product.locations.join(' • ')}</p>
              </div>
            </div>

            <div class={`scarcity-indicator ${isSoldOut ? 'is-sold-out' : ''}`} id="scarcity-indicator-wrap" data-total-slots={product.totalSlots} data-base-reserved={product.reservedSlots}>
              <div class="scarcity-label-row">
                <span class={`slots-left ${isSoldOut ? 'sold-out-text' : ''}`} id="slots-left-text">
                  {isSoldOut ? '🚫 Cupos Agotados' : `🔥 Solo quedan ${remainingSlots} cupos`}
                </span>
                <span class="slots-total" id="slots-total-text">
                  {isSoldOut 
                    ? `${product.totalSlots} de ${product.totalSlots} reservados (100%)` 
                    : `${product.reservedSlots} de ${product.totalSlots} reservados`
                  }
                </span>
              </div>
              <div class="progress-bar-bg">
                <div class={`progress-bar-fill ${isSoldOut ? 'bar-sold-out' : ''}`} id="progress-bar-fill" style={`width: ${isSoldOut ? 100 : (product.reservedSlots / product.totalSlots) * 100}%`}></div>
              </div>
            </div>
          </div>


        </section>

        <!-- Columna Derecha: Formulario de Reserva -->
        <aside class="reservation-col" aria-label="Formulario de reserva">
          <div class="reservation-card" id="reservation-card-container">
            <h2 class="form-title" id="form-header-title">{isSoldOut ? "Tanda Agotada" : "Reserva tu pedido"}</h2>
            <p class="form-subtitle" id="form-header-subtitle">
              {isSoldOut 
                ? "Se han completado todos los cupos disponibles para esta fecha de horneado." 
                : "Selecciona la cantidad que deseas y déjanos tus datos para coordinar tu cupo con la chef."
              }
            </p>

            <!-- Bloque elegante de Tanda Agotada / Reservas Cerradas -->
            <div id="sold-out-notice" class="sold-out-notice-block" style={isSoldOut ? '' : 'display: none;'}>
              <div class="sold-out-pill-badge">
                <span class="sold-out-pill-dot"></span>
                <span>Cupos Agotados • Tanda Completa</span>
              </div>
              <div class="sold-out-icon-wrap">🚫</div>
              <h3 class="sold-out-headline">Reservaciones Cerradas</h3>
              <p class="sold-out-expl">
                Esta tanda artesanal de <strong>{product.name}</strong> ha alcanzado su capacidad máxima de <strong>{product.totalSlots} cupos</strong>. Ya no es posible ingresar nuevas órdenes.
              </p>
              <div class="sold-out-waitlist-box">
                <div class="waitlist-icon">🔔</div>
                <div class="waitlist-text">
                  <strong>¿Deseas estar en lista de espera?</strong>
                  <p>Si algún cupo se libera por cancelación o la chef abre porciones extras, te avisaremos de primero por WhatsApp.</p>
                </div>
              </div>
              <div class="sold-out-buttons">
                <a 
                  href={`https://wa.me/50760000000?text=${encodeURIComponent(`¡Hola Chef Chelsea! 👋 Vi que la tanda de ${product.name} está completa. Me gustaría anotarme en lista de espera por si se libera algún cupo.`)}`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-wa-waitlist"
                >
                  <svg viewBox="0 0 24 24" class="btn-icon" fill="currentColor">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                  </svg>
                  <span>Anotarme en lista de espera por WhatsApp</span>
                </a>
                <a href="/" class="btn-return-catalogue">
                  <span>← Ver catálogo de tandas</span>
                </a>
              </div>
            </div>

            <!-- Contenedor del Formulario (se oculta automáticamente cuando se acaban los cupos) -->
            <div id="reservation-form-container" style={isSoldOut ? 'display: none;' : ''}>
              <!-- Banner de estado del cliente -->
              <div id="customer-session-banner" class="session-banner" style="display: none;">
                <span>👤 Sesión activa: <strong id="logged-user-label"></strong></span>
                <a href="/cuenta" class="session-link">Mi Historial</a>
              </div>

              <div id="guest-session-prompt" class="session-prompt">
                <span>💡 Reservando como invitado.</span>
                <button type="button" id="btn-open-login-inline" class="session-prompt-btn">¿Ya tienes cuenta? Inicia sesión</button>
              </div>

              <form id="reservation-form" class="reservation-form" data-unit-price={product.price} data-product-id={product.id} data-product-name={product.name}>
                <!-- Selector de Cantidad -->
                <div class="form-group">
                  <label class="field-label" for="qty-input">¿Cuántos deseas ordenar?</label>
                  <div class="quantity-controller">
                    <button type="button" class="qty-btn" id="btn-minus" aria-label="Disminuir cantidad">
                      <svg viewBox="0 0 24 24" class="btn-qty-icon" fill="none" stroke="currentColor" stroke-width="3">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                    <input 
                      type="number" 
                      id="qty-input" 
                      name="quantity" 
                      value="1" 
                      min="1" 
                      max={remainingSlots} 
                      readonly 
                      class="qty-display"
                      aria-live="polite"
                    />
                    <button type="button" class="qty-btn" id="btn-plus" aria-label="Aumentar cantidad">
                      <svg viewBox="0 0 24 24" class="btn-qty-icon" fill="none" stroke="currentColor" stroke-width="3">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </button>
                  </div>
                </div>

                <!-- Nombre del cliente -->
                <div class="form-group">
                  <label class="field-label" for="customer-name">Tu nombre y apellido <span class="required">*</span></label>
                  <input 
                    type="text" 
                    id="customer-name" 
                    name="customerName" 
                    placeholder="Ej. Chelsea Morales" 
                    required 
                    class="text-input"
                  />
                </div>

                <!-- Número de contacto -->
                <div class="form-group">
                  <label class="field-label" for="customer-phone">Número de contacto (WhatsApp) <span class="required">*</span></label>
                  <div class="phone-input-wrap">
                    <span class="country-prefix">+507</span>
                    <input 
                      type="tel" 
                      id="customer-phone" 
                      name="customerPhone" 
                      placeholder="6000-0000" 
                      pattern="[0-9\s-]{7,15}"
                      required 
                      class="text-input phone-input"
                    />
                  </div>
                  <span class="field-help">Te escribiremos a este número para coordinar la entrega.</span>
                </div>

                <!-- Opción de crear cuenta para invitados -->
                <div id="guest-account-toggle-wrap" class="guest-toggle-card">
                  <label class="checkbox-flex">
                    <input type="checkbox" id="chk-create-account" />
                    <span class="checkbox-text">Crear una cuenta con estos datos para guardar mi pedido en mi historial</span>
                  </label>

                  <div id="guest-password-fields" class="guest-extra-fields" style="display: none;">
                    <div class="form-group">
                      <label class="field-label" for="guest-email">Correo Electrónico *</label>
                      <input type="email" id="guest-email" placeholder="tu@correo.com" class="text-input" />
                    </div>
                    <div class="form-group">
                      <label class="field-label" for="guest-pass">Crea una Contraseña *</label>
                      <input type="password" id="guest-pass" placeholder="Mínimo 6 caracteres" minlength="6" class="text-input" />
                    </div>
                  </div>
                </div>

                <!-- Punto de entrega / Retiro -->
                <div class="form-group">
                  <label class="field-label" for="pickup-location">Punto de retiro o entrega <span class="required">*</span></label>
                  <select id="pickup-location" name="pickupLocation" required class="text-input select-input">
                    <option value="" disabled selected>Selecciona tu zona</option>
                    <option value="Tierras Altas (Volcán / Bambito)">Tierras Altas (Volcán / Bambito)</option>
                    <option value="Bugaba (Parque / Punto céntrico)">Bugaba (Parque / Punto céntrico)</option>
                    <option value="David (Plaza / Delivery)">David (Plaza / Delivery)</option>
                  </select>
                </div>

                <!-- Notas adicionales -->
                <div class="form-group">
                  <label class="field-label" for="order-notes">Instrucciones o notas adicionales <span class="optional">(opcional)</span></label>
                  <textarea 
                    id="order-notes" 
                    name="orderNotes" 
                    rows="2" 
                    placeholder="Ej. Empacar para regalo, o prefiero retirar a las 3:00 PM..." 
                    class="text-input textarea-input"
                  ></textarea>
                </div>

                <!-- Resumen de Costo -->
                <div class="cost-summary">
                  <div class="summary-row">
                    <span>Precio unitario:</span>
                    <span>${product.price.toFixed(2)}</span>
                  </div>
                  <div class="summary-row">
                    <span>Cantidad:</span>
                    <span id="summary-qty">1</span>
                  </div>
                  <div class="summary-total-row">
                    <span>Total estimado a pagar:</span>
                    <span class="total-price-text" id="summary-total">${product.price.toFixed(2)}</span>
                  </div>
                </div>

                <!-- Botón de Confirmación -->
                <button type="submit" class="btn-confirm-reserve" id="btn-submit-reservation">
                  <svg viewBox="0 0 24 24" class="btn-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Confirmar y Enviar Reserva</span>
                </button>
              </form>

              <p class="trust-note">
                🔒 Pago al momento de retirar o por transferencia bancaria / Yappy tras confirmar disponibilidad.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <!-- Modal de Éxito al Reservar (Confirmación Automática) -->
  <div id="reservation-modal" class="modal-overlay" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true">
      <div class="modal-check-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="modal-badge-pill">✓ Cupo Confirmado Inmediatamente</span>
      <h3 class="modal-title">¡Tu Reserva Está Lista!</h3>
      <p class="modal-text" id="modal-summary-text">
        Tu cupo ha sido reservado y agregado directamente a la lista de horneado.
      </p>

      <div class="modal-actions">
        <a href="/cuenta" id="modal-account-link" class="btn-modal-primary">
          <span>Ver Mi Reserva en Mi Cuenta</span>
        </a>
        <a href="/" class="btn-modal-secondary">
          <span>Explorar Otras Tandas</span>
        </a>
        <button type="button" id="modal-close-btn" class="btn-modal-subtle">
          <span>Seguir en esta página</span>
        </button>
      </div>

      <div class="modal-wa-hint">
        <span>¿Tienes alguna consulta especial?</span>
        <a id="modal-whatsapp-btn" href="#" target="_blank" class="modal-wa-link">
          💬 Escribir opcionalmente por WhatsApp
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { getCurrentUser, registerUser } from '../../services/auth';
  import { createOrder, getActiveReservedSlotsForProduct, syncTandaReservedSlots } from '../../services/orders';

  const form = document.getElementById('reservation-form') as HTMLFormElement;
  const qtyInput = document.getElementById('qty-input') as HTMLInputElement;
  const btnMinus = document.getElementById('btn-minus') as HTMLButtonElement;
  const btnPlus = document.getElementById('btn-plus') as HTMLButtonElement;
  const summaryQty = document.getElementById('summary-qty') as HTMLElement;
  const summaryTotal = document.getElementById('summary-total') as HTMLElement;

  const sessionBanner = document.getElementById('customer-session-banner') as HTMLElement;
  const loggedUserLabel = document.getElementById('logged-user-label') as HTMLElement;
  const guestPrompt = document.getElementById('guest-session-prompt') as HTMLElement;
  const btnOpenLogin = document.getElementById('btn-open-login-inline') as HTMLElement;

  const guestToggleWrap = document.getElementById('guest-account-toggle-wrap') as HTMLElement;
  const chkCreateAccount = document.getElementById('chk-create-account') as HTMLInputElement;
  const guestPasswordFields = document.getElementById('guest-password-fields') as HTMLElement;
  const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement;
  const guestPassInput = document.getElementById('guest-pass') as HTMLInputElement;

  const nameInput = document.getElementById('customer-name') as HTMLInputElement;
  const phoneInput = document.getElementById('customer-phone') as HTMLInputElement;

  const modal = document.getElementById('reservation-modal') as HTMLElement;
  const modalSummaryText = document.getElementById('modal-summary-text') as HTMLElement;
  const modalWhatsappBtn = document.getElementById('modal-whatsapp-btn') as HTMLAnchorElement;
  const modalAccountLink = document.getElementById('modal-account-link') as HTMLAnchorElement;
  const modalCloseBtn = document.getElementById('modal-close-btn') as HTMLButtonElement;

  const scarcityWrap = document.getElementById('scarcity-indicator-wrap');
  const slotsLeftText = document.getElementById('slots-left-text');
  const slotsTotalText = document.getElementById('slots-total-text');
  const progressBarFill = document.getElementById('progress-bar-fill');

  function updateScarcityMeter() {
    if (!scarcityWrap || !form) return;
    const totalSlots = parseInt(scarcityWrap.dataset.totalSlots || "20", 10);
    const baseReserved = parseInt(scarcityWrap.dataset.baseReserved || "0", 10);
    const productId = form.dataset.productId || "";
    const productName = form.dataset.productName || "";
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const productSlug = pathParts.pop() || "";

    const activeOrderSlots = getActiveReservedSlotsForProduct(productId, productName, productSlug, 1);
    const effectiveReserved = Math.max(baseReserved, activeOrderSlots);
    const remaining = Math.max(0, totalSlots - effectiveReserved);
    const isSoldOut = remaining <= 0;
    const pct = isSoldOut ? 100 : Math.min(100, Math.round((effectiveReserved / totalSlots) * 100));

    if (activeOrderSlots > baseReserved) {
      syncTandaReservedSlots(productId, productName, productSlug);
    }

    const formContainer = document.getElementById('reservation-form-container');
    const soldOutNotice = document.getElementById('sold-out-notice');
    const formHeaderTitle = document.getElementById('form-header-title');
    const formHeaderSubtitle = document.getElementById('form-header-subtitle');
    const btnSubmit = document.getElementById('btn-submit-reservation') as HTMLButtonElement;

    if (isSoldOut) {
      if (scarcityWrap) scarcityWrap.classList.add('is-sold-out');
      if (slotsLeftText) {
        slotsLeftText.textContent = '🚫 Cupos Agotados';
        slotsLeftText.classList.add('sold-out-text');
      }
      if (slotsTotalText) slotsTotalText.textContent = `${totalSlots} de ${totalSlots} reservados (100%)`;
      if (progressBarFill) {
        progressBarFill.style.width = '100%';
        progressBarFill.classList.add('bar-sold-out');
      }

      if (formHeaderTitle) formHeaderTitle.textContent = 'Tanda Agotada';
      if (formHeaderSubtitle) formHeaderSubtitle.textContent = 'Se han completado todos los cupos disponibles para esta fecha de horneado.';
      if (soldOutNotice) soldOutNotice.style.display = 'block';
      if (formContainer) formContainer.style.display = 'none';
      if (btnSubmit) {
        btnSubmit.disabled = true;
      }
    } else {
      if (scarcityWrap) scarcityWrap.classList.remove('is-sold-out');
      if (slotsLeftText) {
        slotsLeftText.textContent = `🔥 Solo quedan ${remaining} cupos`;
        slotsLeftText.classList.remove('sold-out-text');
      }
      if (slotsTotalText) slotsTotalText.textContent = `${effectiveReserved} de ${totalSlots} reservados`;
      if (progressBarFill) {
        progressBarFill.style.width = `${pct}%`;
        progressBarFill.classList.remove('bar-sold-out');
      }

      if (formHeaderTitle) formHeaderTitle.textContent = 'Reserva tu pedido';
      if (formHeaderSubtitle) formHeaderSubtitle.textContent = 'Selecciona la cantidad que deseas y déjanos tus datos para coordinar tu cupo con la chef.';
      if (soldOutNotice) soldOutNotice.style.display = 'none';
      if (formContainer) formContainer.style.display = 'block';
      if (btnSubmit) {
        btnSubmit.disabled = false;
      }

      if (qtyInput) {
        qtyInput.setAttribute('max', remaining.toString());
        let currentVal = parseInt(qtyInput.value, 10) || 1;
        if (currentVal > remaining && remaining > 0) {
          qtyInput.value = remaining.toString();
          if (summaryQty) summaryQty.textContent = remaining.toString();
        }
      }
    }
  }

  updateScarcityMeter();
  window.addEventListener('softcookies:orders-updated', updateScarcityMeter);
  window.addEventListener('softcookies:order-created', updateScarcityMeter);

  function updateCustomerState() {
    const user = getCurrentUser();
    if (user) {
      if (sessionBanner) sessionBanner.style.display = 'flex';
      if (loggedUserLabel) loggedUserLabel.textContent = user.name;
      if (guestPrompt) guestPrompt.style.display = 'none';
      if (guestToggleWrap) guestToggleWrap.style.display = 'none';

      if (nameInput && !nameInput.value) nameInput.value = user.name;
      if (phoneInput && !phoneInput.value) phoneInput.value = user.phone;
    } else {
      if (sessionBanner) sessionBanner.style.display = 'none';
      if (guestPrompt) guestPrompt.style.display = 'block';
      if (guestToggleWrap) guestToggleWrap.style.display = 'block';
    }
  }

  updateCustomerState();
  window.addEventListener('softcookies:auth-changed', updateCustomerState);

  btnOpenLogin?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('softcookies:open-auth'));
  });

  chkCreateAccount?.addEventListener('change', () => {
    if (guestPasswordFields) {
      guestPasswordFields.style.display = chkCreateAccount.checked ? 'flex' : 'none';
      if (chkCreateAccount.checked) {
        guestEmailInput?.setAttribute('required', 'true');
        guestPassInput?.setAttribute('required', 'true');
      } else {
        guestEmailInput?.removeAttribute('required');
        guestPassInput?.removeAttribute('required');
      }
    }
  });

  if (form && qtyInput && btnMinus && btnPlus && summaryQty && summaryTotal) {
    const unitPrice = parseFloat(form.dataset.unitPrice || "0");
    const productId = form.dataset.productId || "tarta-vasca";
    const productName = form.dataset.productName || "Pedido";
    const maxQty = parseInt(qtyInput.getAttribute('max') || "20", 10);

    const updateDisplay = () => {
      let qty = parseInt(qtyInput.value, 10);
      if (isNaN(qty) || qty < 1) qty = 1;
      if (qty > maxQty) qty = maxQty;
      
      qtyInput.value = qty.toString();
      summaryQty.textContent = qty.toString();
      
      const total = (qty * unitPrice).toFixed(2);
      summaryTotal.textContent = `$${total}`;
    };

    btnMinus.addEventListener('click', () => {
      let current = parseInt(qtyInput.value, 10);
      if (current > 1) {
        qtyInput.value = (current - 1).toString();
        updateDisplay();
      }
    });

    btnPlus.addEventListener('click', () => {
      let current = parseInt(qtyInput.value, 10);
      if (current < maxQty) {
        qtyInput.value = (current + 1).toString();
        updateDisplay();
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = nameInput.value.trim();
      const phone = phoneInput.value.trim();
      const location = (document.getElementById('pickup-location') as HTMLSelectElement).value;
      const notes = (document.getElementById('order-notes') as HTMLTextAreaElement).value.trim();
      const qty = parseInt(qtyInput.value, 10);
      let currentUser = getCurrentUser();

      // Guard check: verify cupos are still available before submitting
      const totalSlots = parseInt(scarcityWrap?.dataset.totalSlots || "20", 10);
      const baseReserved = parseInt(scarcityWrap?.dataset.baseReserved || "0", 10);
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const productSlug = pathParts.pop() || "";
      const currentActive = getActiveReservedSlotsForProduct(productId, productName, productSlug, 1);
      const effectiveReserved = Math.max(baseReserved, currentActive);
      const currentRemaining = Math.max(0, totalSlots - effectiveReserved);

      if (currentRemaining <= 0) {
        alert('Lo sentimos, los cupos para esta tanda se han completado y las reservaciones están cerradas.');
        updateScarcityMeter();
        return;
      }

      if (qty > currentRemaining) {
        alert(`Lo sentimos, solo quedan ${currentRemaining} cupo(s) disponible(s). Ajusta la cantidad antes de enviar.`);
        updateScarcityMeter();
        return;
      }

      // If guest wants to register account along with order
      if (!currentUser && chkCreateAccount?.checked) {
        const email = guestEmailInput.value.trim();
        const pass = guestPassInput.value;
        if (email && pass) {
          try {
            currentUser = registerUser(name, email, phone, pass);
          } catch (err: any) {
            alert(err.message || 'Error al crear la cuenta. La reserva continuará como invitado.');
          }
        }
      }

      // Save order in orders service
      const createdOrder = createOrder({
        customerId: currentUser?.id,
        customerName: name,
        customerPhone: phone,
        pickupLocation: location,
        notes,
        productId,
        productName,
        unitPrice,
        quantity: qty,
        totalSlots
      });

      // WhatsApp Message
      let message = `¡Hola Chef Chelsea! 👋 Deseo confirmar mi reserva *#${createdOrder.orderNumber}* en Soft Cookies:\n\n`;
      message += `🍰 *Producto:* ${productName}\n`;
      message += `📦 *Cantidad:* ${qty}\n`;
      message += `💰 *Total estimado:* $${createdOrder.total.toFixed(2)}\n\n`;
      message += `👤 *Nombre:* ${name}\n`;
      message += `📞 *Teléfono:* +507 ${phone}\n`;
      message += `📍 *Lugar de entrega:* ${location}\n`;
      if (notes) {
        message += `📝 *Notas:* ${notes}\n`;
      }
      message += `\n¡Quedo atento a la confirmación de mi cupo! Muchas gracias ✨`;

      const cleanPhone = '50760000000'; // Default Soft Cookies / Chef WhatsApp
      const whatsappUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;

      // Update Modal
      if (modal && modalSummaryText) {
        modalSummaryText.innerHTML = `¡Gracias, <strong>${name}</strong>! Tu reserva <strong>#${createdOrder.orderNumber}</strong> de <strong>${qty}x ${productName}</strong> ($${createdOrder.total.toFixed(2)}) ha sido <strong>confirmada de inmediato</strong> y agregada a la lista de horneado.`;
        if (modalWhatsappBtn) modalWhatsappBtn.href = whatsappUrl;

        if (modalAccountLink) {
          modalAccountLink.style.display = 'inline-flex';
        }

        modal.classList.add('modal-visible');
        modal.setAttribute('aria-hidden', 'false');
      }
    });

    if (modalCloseBtn && modal) {
      modalCloseBtn.addEventListener('click', () => {
        modal.classList.remove('modal-visible');
        modal.setAttribute('aria-hidden', 'true');
      });
    }
  }
</script>

