  function clearPhoto() {
    if (photoFile) photoFile.value = '';
    if (photoData) photoData.value = '';
    if (photoUrlInput) photoUrlInput.value = '';
    if (uploadPrompt) uploadPrompt.style.display = 'flex';
    if (previewWrap) previewWrap.style.display = 'none';
