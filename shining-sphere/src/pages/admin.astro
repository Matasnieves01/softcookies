  let confirmResolve: ((value: boolean) => void) | null = null;

  function showConfirmDialog(options: {
    title?: string;
    message: string;
    confirmText?: string;
    cancelText?: string;
    isDanger?: boolean;
    icon?: string;
  }): Promise<boolean> {
    return new Promise((resolve) => {
      confirmResolve = resolve;

      if (confirmModalTitle) confirmModalTitle.textContent = options.title || '¿Estás seguro?';
      if (confirmModalDesc) confirmModalDesc.innerHTML = options.message;
      if (confirmModalIcon) confirmModalIcon.textContent = options.icon || (options.isDanger !== false ? '🗑️' : '❓');
      if (confirmModalActionText) confirmModalActionText.textContent = options.confirmText || 'Confirmar';
      if (confirmModalBtnCancel) {
        confirmModalBtnCancel.style.display = 'block';
        confirmModalBtnCancel.textContent = options.cancelText || 'Cancelar';
      }

      if (confirmModalIconWrap) {
        confirmModalIconWrap.className = 'confirm-modal-icon-wrap' + (options.isDanger !== false ? '' : ' is-info');
      }

      if (confirmModalBtnAction) {
        confirmModalBtnAction.className = options.isDanger !== false ? 'btn-confirm-danger' : 'btn-confirm-primary';
      }

      if (confirmModal) {
        confirmModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });
  }

  function showAlertDialog(message: string, title: string = 'Atención', icon: string = '⚠️'): Promise<boolean> {
    return new Promise((resolve) => {
      confirmResolve = resolve;

      if (confirmModalTitle) confirmModalTitle.textContent = title;
      if (confirmModalDesc) confirmModalDesc.innerHTML = message;
      if (confirmModalIcon) confirmModalIcon.textContent = icon;
      if (confirmModalActionText) confirmModalActionText.textContent = 'Entendido';
      if (confirmModalBtnCancel) confirmModalBtnCancel.style.display = 'none';

      if (confirmModalIconWrap) {
        confirmModalIconWrap.className = 'confirm-modal-icon-wrap is-warning';
      }

      if (confirmModalBtnAction) {
        confirmModalBtnAction.className = 'btn-confirm-primary';
      }

      if (confirmModal) {
        confirmModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });
  }

  function closeConfirmDialog(result: boolean) {
    if (confirmModal) {
      confirmModal.style.display = 'none';
      if (!editTandaModal || editTandaModal.style.display !== 'flex') {
        document.body.style.overflow = '';
