---
import Layout from '../layouts/Layout.astro';
import TopBanner from '../components/TopBanner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
---

<Layout 
  title="Panel de la Chef | Soft Cookies Admin" 
  description="Panel exclusivo para la gestión de tandas, promociones y reservas de clientes de Soft Cookies."
>
  <TopBanner text="• PANEL EXCLUSIVO DE ADMINISTRACIÓN • CHEF CHELSEA" />
  <Navbar brandName="Soft Cookies" instagramHandle="@softcookies.pty" />

  <main class="admin-page">
    <div class="container">
      <!-- Acceso no autorizado (Login de la Chef) -->
      <section id="admin-login-view" class="admin-auth-card" style="display: none;">
        <div class="lock-icon">🔒</div>
        <h1 class="admin-auth-title">Acceso Chef Administradora</h1>
        <p class="admin-auth-desc">
          Ingresa la contraseña de administradora para acceder al panel de control de tandas y pedidos.
        </p>

        <form id="admin-login-form" class="admin-form">
          <div class="form-group">
            <label for="admin-pass">Contraseña de Acceso</label>
            <div class="password-input-row">
              <input 
                type="password" 
                id="admin-pass" 
                placeholder="Ingresa la contraseña de la chef" 
                required 
                autocomplete="current-password"
                class="admin-input" 
              />
              <button type="button" id="btn-toggle-pass" class="btn-toggle-pwd" aria-label="Mostrar u ocultar contraseña">
                👁️
              </button>
            </div>
          </div>

          <div id="admin-login-error" class="admin-error" style="display: none;"></div>

          <button type="submit" class="btn-admin-submit">
            <span>Acceder al Panel</span>
          </button>
        </form>
      </section>

      <!-- Panel de Control Autorizado -->
      <div id="admin-dashboard-view" class="admin-dashboard" style="display: none;">
        <!-- Header del Dashboard -->
        <header class="admin-header-bar">
          <div>
            <span class="admin-welcome-tag">Micro-Bakehouse Admin</span>
            <h1 class="admin-main-title">Panel de Control de la Chef</h1>
            <p class="admin-main-sub">Gestiona tus tandas de horneado, publica promociones y revisa los pedidos recibidos.</p>
          </div>

          <div class="admin-top-actions">
            <a href="/" class="btn-view-store">Ver Tienda</a>
            <button type="button" id="btn-admin-logout" class="btn-admin-exit">Salir</button>
          </div>
        </header>

        <!-- Métricas Rápidas -->
        <section class="metrics-grid">
          <div class="metric-card">
            <span class="metric-icon">📦</span>
            <div>
              <span class="metric-value" id="metric-total-orders">0</span>
              <span class="metric-label">Reservas Recibidas</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">⏳</span>
            <div>
              <span class="metric-value" id="metric-pending-orders">0</span>
              <span class="metric-label">Pendientes por Confirmar</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">💰</span>
            <div>
              <span class="metric-value" id="metric-total-revenue">$0.00</span>
              <span class="metric-label">Total en Reservas</span>
            </div>
          </div>
        </section>

        <!-- Tabs de Navegación del Panel -->
        <div class="admin-nav-tabs">
          <button type="button" class="tab-btn active" data-tab="orders">
            <span>📥 Bandeja de Reservas</span>
          </button>
          <button type="button" class="tab-btn" data-tab="create-promo">
            <span>✨ Publicar Nueva Promoción</span>
          </button>
          <button type="button" class="tab-btn" data-tab="manage-promos">
            <span>📋 Tandas y Promociones</span>
          </button>
          <button type="button" class="tab-btn" data-tab="security">
            <span>🔐 Contraseña</span>
          </button>
        </div>

        <!-- TAB 1: Bandeja de Reservas -->
        <section id="tab-content-orders" class="tab-content active">
          <div class="content-header">
            <h2 class="content-title">Reservas Entrantes</h2>
            <div class="filter-pills">
              <button type="button" class="filter-btn active" data-status="all">Todas</button>
              <button type="button" class="filter-btn" data-status="pending">Pendientes</button>
              <button type="button" class="filter-btn" data-status="confirmed">Confirmadas</button>
            </div>
          </div>

          <div id="admin-orders-list" class="admin-orders-container"></div>
        </section>

        <!-- TAB 2: Publicar Nueva Promoción -->
        <section id="tab-content-create-promo" class="tab-content" style="display: none;">
          <div class="form-container-card">
            <div class="form-intro">
              <h2 class="content-title">Crear Nueva Tanda o Promoción</h2>
              <p>Completa los datos del producto horneado para que los clientes puedan verlo y reservarlo.</p>
            </div>

            <form id="create-promo-form" class="create-promo-form">
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="promo-name">Nombre del Producto / Tanda *</label>
                  <input type="text" id="promo-name" required placeholder="Ej. Tarta Vasca de Pistacho" class="admin-input" />
                </div>

                <div class="form-group">
                  <label for="promo-subtitle">Subtítulo Artesanal *</label>
                  <input type="text" id="promo-subtitle" required placeholder="Ej. Cremosa con pistacho tostado de Sicilia" class="admin-input" />
                </div>
              </div>

              <div class="form-grid-3">
                <div class="form-group">
                  <label for="promo-price">Precio ($) *</label>
                  <input type="number" id="promo-price" step="0.50" min="1" required placeholder="6.50" class="admin-input" />
                </div>

                <div class="form-group">
                  <label for="promo-unit">Unidad *</label>
                  <select id="promo-unit" class="admin-input">
                    <option value="/ porción">/ porción</option>
                    <option value="/ box">/ box</option>
                    <option value="/ unidad">/ unidad</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="promo-slots">Cupos Totales *</label>
                  <input type="number" id="promo-slots" min="1" required placeholder="25" class="admin-input" />
                </div>
              </div>

              <div class="form-group">
                <label for="promo-dates">Fechas de la Tanda *</label>
                <input type="text" id="promo-dates" required placeholder="Ej. Sábado 28 & Domingo 29 Sept" class="admin-input" />
              </div>

              <div class="form-group">
                <label for="promo-short-desc">Descripción Breve *</label>
                <input type="text" id="promo-short-desc" required placeholder="Resumen corto para la tarjeta" class="admin-input" />
              </div>

              <div class="form-group">
                <label for="promo-long-desc">Descripción Completa de la Receta *</label>
                <textarea id="promo-long-desc" rows="3" required placeholder="Cuéntale a tus clientes sobre la textura, preparación y el cariño puesto en este horneado..." class="admin-input"></textarea>
              </div>

              <div class="form-group">
                <label for="promo-image">Imagen del Producto</label>
                <select id="promo-image" class="admin-input">
                  <option value="/images/tarta-vasca.jpg">Tarta Vasca con Frutos Rojos (Foto Principal)</option>
                  <option value="/images/tarta-vasca.jpg">Caja Degustación Especial</option>
                </select>
              </div>

              <div id="promo-feedback" class="admin-success-msg" style="display: none;"></div>

              <button type="submit" class="btn-publish-promo">
                <span>✨ Publicar Tanda Inmediatamente</span>
              </button>
            </form>
          </div>
        </section>

        <!-- TAB 3: Gestionar Promociones -->
        <section id="tab-content-manage-promos" class="tab-content" style="display: none;">
          <div class="content-header">
            <h2 class="content-title">Tandas y Productos en Catálogo</h2>
          </div>

          <div id="admin-promos-list" class="admin-promos-container"></div>
        </section>

        <!-- TAB 4: Seguridad y Contraseña -->
        <section id="tab-content-security" class="tab-content" style="display: none;">
          <div class="form-container-card" style="max-width: 500px; margin: 0 auto;">
            <div class="form-intro">
              <h2 class="content-title">Cambiar Contraseña de Administradora</h2>
              <p>Modifica la clave de acceso requerida para ingresar a este panel mediante la URL /admin.</p>
            </div>

            <form id="change-pass-form" class="create-promo-form">
              <div class="form-group">
                <label for="new-admin-pass">Nueva Contraseña de Acceso *</label>
                <input 
                  type="password" 
                  id="new-admin-pass" 
                  required 
                  minlength="4" 
                  placeholder="Mínimo 4 caracteres (ej. miClave2026)" 
                  class="admin-input" 
                />
              </div>

              <div id="change-pass-feedback" class="admin-success-msg" style="display: none;"></div>

              <button type="submit" class="btn-publish-promo">
                <span>Guardar Nueva Contraseña</span>
              </button>
            </form>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
  <BottomNav activeTab="perfil" />
</Layout>

<script>
  import { getCurrentUser, loginAdminWithPassword, changeAdminPassword, logoutUser, isAdminUser } from '../services/auth';
  import { getAllOrders, updateOrderStatus } from '../services/orders';
  import { getAllPromotions, createPromotion, togglePromotionStatus, deletePromotion } from '../services/promotions';
  import type { Order, Promotion } from '../types';

  const loginView = document.getElementById('admin-login-view') as HTMLElement;
  const dashboardView = document.getElementById('admin-dashboard-view') as HTMLElement;
  const loginForm = document.getElementById('admin-login-form') as HTMLFormElement;
  const loginError = document.getElementById('admin-login-error') as HTMLElement;
  const logoutBtn = document.getElementById('btn-admin-logout') as HTMLElement;

  const metricTotalOrders = document.getElementById('metric-total-orders') as HTMLElement;
  const metricPendingOrders = document.getElementById('metric-pending-orders') as HTMLElement;
  const metricTotalRevenue = document.getElementById('metric-total-revenue') as HTMLElement;

  const tabButtons = document.querySelectorAll('.admin-nav-tabs .tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  const ordersContainer = document.getElementById('admin-orders-list') as HTMLElement;
  const promosContainer = document.getElementById('admin-promos-list') as HTMLElement;
  const createPromoForm = document.getElementById('create-promo-form') as HTMLFormElement;
  const promoFeedback = document.getElementById('promo-feedback') as HTMLElement;

  let currentStatusFilter = 'all';

  function initAdmin() {
    if (!isAdminUser()) {
      if (loginView) loginView.style.display = 'block';
      if (dashboardView) dashboardView.style.display = 'none';
      return;
    }

    if (loginView) loginView.style.display = 'none';
    if (dashboardView) dashboardView.style.display = 'block';

    renderDashboard();
  }

  function renderDashboard() {
    renderMetrics();
    renderOrders();
    renderPromotions();
  }

  function renderMetrics() {
    const orders = getAllOrders();
    const pending = orders.filter((o) => o.status === 'pending').length;
    const revenue = orders.reduce((sum, o) => sum + o.total, 0);

    if (metricTotalOrders) metricTotalOrders.textContent = orders.length.toString();
    if (metricPendingOrders) metricPendingOrders.textContent = pending.toString();
    if (metricTotalRevenue) metricTotalRevenue.textContent = `$${revenue.toFixed(2)}`;
  }

  function renderOrders() {
    if (!ordersContainer) return;
    let orders = getAllOrders();

    if (currentStatusFilter !== 'all') {
      orders = orders.filter((o) => o.status === currentStatusFilter);
    }

    if (orders.length === 0) {
      ordersContainer.innerHTML = `
        <div class="empty-admin-box">
          <p>No hay reservas ${currentStatusFilter !== 'all' ? 'con este estado' : 'registradas aún'}.</p>
        </div>
      `;
      return;
    }

    ordersContainer.innerHTML = orders
      .map((o) => {
        const isPending = o.status === 'pending';
        const isConfirmed = o.status === 'confirmed';
        const cleanPhone = o.customerPhone.replace(/[^0-9]/g, '');
        const waLink = `https://wa.me/507${cleanPhone}?text=${encodeURIComponent(
          `¡Hola ${o.customerName}! Te saluda Chef Chelsea de Soft Cookies respecto a tu reserva ${o.orderNumber} de ${o.item.productName}.`
        )}`;

        return `
          <div class="admin-order-card ${isPending ? 'border-pending' : ''}">
            <div class="order-top-bar">
              <div>
                <span class="order-id">${o.orderNumber}</span>
                <span class="customer-type-tag">${o.customerId ? '👤 Cliente Registrado' : '🏷️ Invitado'}</span>
              </div>
              <span class="admin-status-pill status-${o.status}">
                ${o.status === 'pending' ? 'Pendiente' : o.status === 'confirmed' ? 'Confirmado' : 'Entregado'}
              </span>
            </div>

            <div class="order-main-info">
              <h3 class="order-item-title">${o.item.quantity}x ${o.item.productName}</h3>
              <p class="order-pricing">Total: <strong>$${o.total.toFixed(2)}</strong> ($${o.item.unitPrice.toFixed(2)} c/u)</p>
            </div>

            <div class="order-customer-details">
              <p>👤 <strong>Cliente:</strong> ${o.customerName}</p>
              <p>📞 <strong>Teléfono:</strong> +507 ${o.customerPhone}</p>
              <p>📍 <strong>Entrega:</strong> ${o.pickupLocation}</p>
              ${o.notes ? `<p>📝 <strong>Notas:</strong> "${o.notes}"</p>` : ''}
            </div>

            <div class="order-actions-bar">
              <a href="${waLink}" target="_blank" class="btn-wa-chat">
                <span>💬 Escribir por WhatsApp</span>
              </a>

              ${
                isPending
                  ? `<button type="button" class="btn-status-confirm" data-id="${o.id}">✓ Confirmar Cupo</button>`
                  : isConfirmed
                  ? `<button type="button" class="btn-status-deliver" data-id="${o.id}">Marcar Entregado</button>`
                  : `<span class="badge-done">Listo</span>`
              }
            </div>
          </div>
        `;
      })
      .join('');

    // Attach status change events
    ordersContainer.querySelectorAll('.btn-status-confirm').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        updateOrderStatus(id, 'confirmed');
        renderDashboard();
      });
    });

    ordersContainer.querySelectorAll('.btn-status-deliver').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        updateOrderStatus(id, 'delivered');
        renderDashboard();
      });
    });
  }

  function renderPromotions() {
    if (!promosContainer) return;
    const promos = getAllPromotions();

    promosContainer.innerHTML = promos
      .map((p) => {
        return `
          <div class="admin-promo-card">
            <div class="promo-thumb">
              <img src="${p.image}" alt="${p.name}" />
            </div>
            <div class="promo-info">
              <h3 class="promo-name">${p.name}</h3>
              <p class="promo-sub">${p.subtitle}</p>
              <p class="promo-meta">
                <strong>$${p.price.toFixed(2)} ${p.unit}</strong> • 
                Fechas: ${p.batchDates} • 
                Cupos: ${p.reservedSlots}/${p.totalSlots}
              </p>
            </div>
            <div class="promo-actions">
              <button type="button" class="btn-toggle-promo ${p.isActive ? 'btn-active' : 'btn-paused'}" data-id="${p.id}">
                ${p.isActive ? 'Activa' : 'Pausada'}
              </button>
              <button type="button" class="btn-delete-promo" data-id="${p.id}">
                Eliminar
              </button>
            </div>
          </div>
        `;
      })
      .join('');

    promosContainer.querySelectorAll('.btn-toggle-promo').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        togglePromotionStatus(id);
        renderPromotions();
      });
    });

    promosContainer.querySelectorAll('.btn-delete-promo').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        if (confirm('¿Deseas eliminar esta promoción?')) {
          deletePromotion(id);
          renderPromotions();
        }
      });
    });
  }

  // Handle Tab Switch
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = (btn as HTMLElement).dataset.tab;
      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      tabContents.forEach((tc) => {
        if ((tc as HTMLElement).id === `tab-content-${tabName}`) {
          (tc as HTMLElement).style.display = 'block';
        } else {
          (tc as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Filter Buttons
  document.querySelectorAll('.filter-pills .filter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-pills .filter-btn').forEach((b) => b.classList.remove('active'));
      (e.currentTarget as HTMLElement).classList.add('active');
      currentStatusFilter = (e.currentTarget as HTMLElement).dataset.status || 'all';
      renderOrders();
    });
  });

  // Create Promo Form Submit
  createPromoForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = (document.getElementById('promo-name') as HTMLInputElement).value;
    const subtitle = (document.getElementById('promo-subtitle') as HTMLInputElement).value;
    const price = parseFloat((document.getElementById('promo-price') as HTMLInputElement).value);
    const unit = (document.getElementById('promo-unit') as HTMLSelectElement).value;
    const totalSlots = parseInt((document.getElementById('promo-slots') as HTMLInputElement).value, 10);
    const batchDates = (document.getElementById('promo-dates') as HTMLInputElement).value;
    const shortDescription = (document.getElementById('promo-short-desc') as HTMLInputElement).value;
    const longDescription = (document.getElementById('promo-long-desc') as HTMLTextAreaElement).value;
    const image = (document.getElementById('promo-image') as HTMLSelectElement).value;

    createPromotion({
      name,
      subtitle,
      price,
      unit,
      totalSlots,
      batchDates,
      shortDescription,
      longDescription,
      image
    });

    if (promoFeedback) {
      promoFeedback.textContent = '¡Tanda y promoción publicada con éxito! Ya está disponible en el catálogo.';
      promoFeedback.style.display = 'block';
      setTimeout(() => {
        promoFeedback.style.display = 'none';
        createPromoForm.reset();
        // Switch to manage tab
        const manageTab = document.querySelector('[data-tab="manage-promos"]') as HTMLButtonElement;
        manageTab?.click();
      }, 1200);
    }
  });

  // Toggle pass visibility
  const togglePassBtn = document.getElementById('btn-toggle-pass');
  togglePassBtn?.addEventListener('click', () => {
    const passInput = document.getElementById('admin-pass') as HTMLInputElement;
    if (passInput) {
      passInput.type = passInput.type === 'password' ? 'text' : 'password';
    }
  });

  // Admin Login Handle
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (loginError) {
      loginError.style.display = 'none';
      loginError.textContent = '';
    }
    const passInput = document.getElementById('admin-pass') as HTMLInputElement;
    const pass = passInput?.value || '';

    try {
      loginAdminWithPassword(pass);
      initAdmin();
    } catch (err: any) {
      if (loginError) {
        loginError.textContent = err.message || 'Contraseña incorrecta';
        loginError.style.display = 'block';
      }
    }
  });

  // Change Password Handle
  const changePassForm = document.getElementById('change-pass-form') as HTMLFormElement;
  const changePassFeedback = document.getElementById('change-pass-feedback') as HTMLElement;
  changePassForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newPassInput = document.getElementById('new-admin-pass') as HTMLInputElement;
    const newPass = newPassInput?.value || '';

    try {
      changeAdminPassword(newPass);
      if (changePassFeedback) {
        changePassFeedback.textContent = '¡Contraseña actualizada con éxito!';
        changePassFeedback.style.display = 'block';
        setTimeout(() => {
          changePassFeedback.style.display = 'none';
          changePassForm.reset();
        }, 2500);
      }
    } catch (err: any) {
      alert(err.message || 'Error al actualizar la contraseña');
    }
  });

  logoutBtn?.addEventListener('click', () => {
    logoutUser();
    const passInput = document.getElementById('admin-pass') as HTMLInputElement;
    if (passInput) passInput.value = '';
    initAdmin();
  });

  // Start
  initAdmin();
</script>

<style>
  .admin-page {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  /* Admin Login View */
  .admin-auth-card {
    background-color: var(--color-surface-card);
    border-radius: var(--radius-xl);
    padding: 3rem 2rem;
    text-align: center;
    max-width: 460px;
    margin: 2rem auto;
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-hover);
  }

  .lock-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
  }

  .admin-auth-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-on-surface);
    margin-bottom: 0.4rem;
  }

  .admin-auth-desc {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
    line-height: 1.45;
  }

  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    text-align: left;
  }

  .admin-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    background-color: #fffdf9;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-on-surface);
  }

  .admin-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(141, 75, 0, 0.15);
  }

  .password-input-row {
    position: relative;
    display: flex;
    align-items: center;
  }

  .password-input-row .admin-input {
    padding-right: 2.75rem;
  }

  .btn-toggle-pwd {
    position: absolute;
    right: 0.6rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.15rem;
    padding: 0.25rem 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .btn-toggle-pwd:hover {
    opacity: 1;
  }

  .admin-error {
    background-color: var(--color-error-container);
    color: var(--color-on-error-container);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-md);
    font-size: 0.825rem;
    font-weight: 700;
  }

  .btn-admin-submit {
    padding: 0.9rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 800;
    transition: all 0.2s ease;
  }

  .btn-admin-submit:hover {
    background-color: var(--color-primary-hover);
  }

  /* Admin Dashboard */
  .admin-dashboard {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .admin-header-bar {
    background-color: var(--color-surface-card);
    border-radius: var(--radius-xl);
    padding: 1.75rem 2rem;
    border: 1px solid var(--color-border-subtle);
