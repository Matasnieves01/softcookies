---
import Layout from '../layouts/Layout.astro';
import TopBanner from '../components/TopBanner.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Panel de la Chef | Soft Cookies Admin" 
  description="Panel exclusivo para la gestión de tandas, promociones y reservas de clientes de Soft Cookies."
>
  <TopBanner text="• PANEL EXCLUSIVO DE ADMINISTRACIÓN • CHEF CHELSEA" />
  <Navbar brandName="Soft Cookies" instagramHandle="@softcookies.pty" activeTab="perfil" />

  <main class="admin-page">
    <div class="container">
      <!-- Acceso no autorizado (Login de la Chef) -->
      <section id="admin-login-view" class="admin-auth-card" style="display: none;">
        <div class="lock-icon">🔒</div>
        <h1 class="admin-auth-title">Acceso Chef Administradora</h1>
        <p class="admin-auth-desc">
          Ingresa la contraseña de administradora para acceder al panel de control de tandas y pedidos.
        </p>

        <form id="admin-login-form" class="admin-form">
          <div class="form-group">
            <label for="admin-pass">Contraseña de Acceso</label>
            <div class="password-input-row">
              <input 
                type="password" 
                id="admin-pass" 
                placeholder="Ingresa la contraseña de la chef" 
                required 
                autocomplete="current-password"
                class="admin-input" 
              />
              <button type="button" id="btn-toggle-pass" class="btn-toggle-pwd" aria-label="Mostrar u ocultar contraseña">
                👁️
              </button>
            </div>
          </div>

          <div id="admin-login-error" class="admin-error" style="display: none;"></div>

          <button type="submit" class="btn-admin-submit">
            <span>Acceder al Panel</span>
          </button>
        </form>
      </section>

      <!-- Panel de Control Autorizado -->
      <div id="admin-dashboard-view" class="admin-dashboard" style="display: none;">
        <!-- Header del Dashboard -->
        <header class="admin-header-bar">
          <div>
            <span class="admin-welcome-tag">Micro-Bakehouse Admin</span>
            <h1 class="admin-main-title">Panel de Control de la Chef</h1>
            <p class="admin-main-sub">Gestiona tus tandas de horneado, publica promociones y revisa los pedidos recibidos.</p>
          </div>

          <div class="admin-top-actions">
            <button type="button" id="btn-admin-create-cta" class="btn-admin-cta">
              <span>✨ + Crear Tanda</span>
            </button>
            <a href="/" class="btn-view-store">Ver Tienda</a>
            <button type="button" id="btn-admin-logout" class="btn-admin-exit">Salir</button>
          </div>
        </header>

        <!-- Métricas Rápidas -->
        <section class="metrics-grid">
          <div class="metric-card">
            <span class="metric-icon">📦</span>
            <div>
              <span class="metric-value" id="metric-total-orders">0</span>
              <span class="metric-label">Reservas Recibidas</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">✓</span>
            <div>
              <span class="metric-value" id="metric-confirmed-orders">0</span>
              <span class="metric-label">Reservas Activas</span>
            </div>
          </div>

          <div class="metric-card">
            <span class="metric-icon">💰</span>
            <div>
              <span class="metric-value" id="metric-total-revenue">$0.00</span>
              <span class="metric-label">Total en Reservas</span>
            </div>
          </div>
        </section>

        <!-- Tabs de Navegación del Panel -->
        <div class="admin-nav-tabs">
          <button type="button" class="tab-btn active" data-tab="orders">
            <span>📥 Bandeja de Reservas</span>
          </button>
          <button type="button" class="tab-btn" data-tab="create-promo">
            <span>✨ Crear Nueva Tanda</span>
          </button>
          <button type="button" class="tab-btn" data-tab="manage-promos">
            <span>📋 Gestionar Tandas</span>
          </button>
          <button type="button" class="tab-btn" data-tab="security">
            <span>🔐 Contraseña</span>
          </button>
        </div>

        <!-- TAB 1: Bandeja de Reservas -->
        <section id="tab-content-orders" class="tab-content active">
          <div class="content-header">
            <h2 class="content-title">Reservas Entrantes</h2>
            <div class="filter-pills">
              <button type="button" class="filter-btn active" data-status="all">Todas</button>
              <button type="button" class="filter-btn" data-status="confirmed">Confirmadas</button>
              <button type="button" class="filter-btn" data-status="delivered">Entregadas</button>
              <button type="button" class="filter-btn" data-status="cancelled">Canceladas</button>
            </div>
          </div>

          <div id="admin-orders-list" class="admin-orders-container"></div>
        </section>

        <!-- TAB 2: Publicar Nueva Tanda -->
        <section id="tab-content-create-promo" class="tab-content" style="display: none;">
          <div class="form-container-card">
            <div class="form-intro">
              <h2 class="content-title">Publicar Nueva Tanda</h2>
              <p>Ingresa la foto, datos del horneado, fecha de reparto y cupos disponibles para que los clientes puedan reservar.</p>
            </div>

            <form id="create-promo-form" class="create-promo-form">
              <!-- Foto de la Tanda -->
              <div class="form-group photo-upload-group">
                <label for="promo-image-file">Foto de la Tanda *</label>
                <div class="photo-upload-zone" id="photo-upload-zone">
                  <input type="file" id="promo-image-file" accept="image/*" class="file-input-hidden" />
                  <input type="hidden" id="promo-image-data" required />
                  <div id="upload-prompt" class="upload-prompt">
                    <span class="upload-icon">📷</span>
                    <span class="upload-text">Selecciona una foto de tu producto horneado</span>
                    <span class="upload-hint">Haz clic o arrastra una imagen (JPG, PNG, WebP)</span>
                  </div>
                  <div id="upload-preview-wrap" class="upload-preview-wrap" style="display: none;">
                    <img id="upload-preview-img" src="" alt="Previsualización" class="upload-preview-img" />
                    <button type="button" id="btn-remove-photo" class="btn-remove-photo" title="Cambiar foto">✕ Cambiar foto</button>
                  </div>
                </div>
                <div class="url-fallback-row">
                  <small>O si tienes un enlace directo a la imagen:</small>
                  <input type="url" id="promo-image-url" placeholder="https://ejemplo.com/foto.jpg" class="admin-input input-sm" />
                </div>
                <div class="photo-presets-row">
                  <small>Fotos rápidas sugeridas:</small>
                  <button type="button" class="btn-admin-preset" data-img="/images/tarta-vasca.jpg">🍰 Tarta Vasca</button>
                  <button type="button" class="btn-admin-preset" data-img="/images/logo.jpeg">🍪 Logo Soft Cookies</button>
                </div>
              </div>

              <!-- Nombre y Subtítulo -->
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="promo-name">Nombre de la Tanda / Producto *</label>
                  <input type="text" id="promo-name" required placeholder="Ej. Tarta Vasca con Frutos Rojos" class="admin-input" />
                </div>

                <div class="form-group">
                  <label for="promo-subtitle">Subtítulo o Destacado (opcional)</label>
                  <input type="text" id="promo-subtitle" placeholder="Ej. Cremosa con centro fundente y compota casera" class="admin-input" />
                </div>
              </div>

              <!-- Día de reparto y Cupos disponibles -->
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="promo-date-picker">Día en que se repartirá *</label>
                  
                  <div 
                    class="calendar-block-trigger" 
                    id="delivery-date-block" 
                    tabindex="0" 
                    role="button" 
                    aria-label="Abrir calendario para seleccionar fecha de entrega"
                  >
                    <!-- Input de fecha nativo cubriendo todo el bloque de forma invisible para soporte nativo y accesibilidad -->
                    <input 
                      type="date" 
                      id="promo-date-picker" 
                      class="calendar-native-input-overlay" 
                      required 
                    />

                    <!-- Contenido visual del bloque -->
                    <div class="calendar-block-content">
                      <div class="calendar-block-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                          <line x1="16" x2="16" y1="2" y2="6"/>
                          <line x1="8" x2="8" y1="2" y2="6"/>
                          <line x1="3" x2="21" y1="10" y2="10"/>
                          <path d="M8 14h.01"/>
                          <path d="M12 14h.01"/>
                          <path d="M16 14h.01"/>
                          <path d="M8 18h.01"/>
                          <path d="M12 18h.01"/>
                        </svg>
                      </div>

                      <div class="calendar-block-info">
                        <span class="calendar-block-title" id="calendar-block-title">Toca aquí para seleccionar día</span>
                        <span class="calendar-block-subtitle" id="calendar-block-subtitle">Haz clic en cualquier parte del bloque para abrir el calendario</span>
                      </div>
                    </div>
                  </div>

                  <!-- Valor resultante formateado para la base de datos -->
                  <input 
                    type="hidden" 
                    id="promo-dates" 
                    name="batchDates" 
                    required 
                  />
                  <small class="field-help-text">💡 Todo el bloque abre el calendario interactivo directamente.</small>
                </div>

                <div class="form-group">
                  <label for="promo-slots">Cuántos cupos habrán disponibles *</label>
                  <input type="number" id="promo-slots" min="1" required placeholder="Ej. 25" class="admin-input" />
                </div>
              </div>

              <!-- Precio y Unidad -->
              <div class="form-grid-2">
                <div class="form-group">
                  <label for="promo-price">Precio ($) *</label>
                  <input type="number" id="promo-price" step="0.50" min="0.50" required placeholder="6.50" class="admin-input" />
                </div>

                <div class="form-group">
                  <label for="promo-unit">Unidad de venta</label>
                  <select id="promo-unit" class="admin-input">
                    <option value="/ porción">/ porción</option>
                    <option value="/ unidad">/ unidad</option>
                    <option value="/ box">/ box</option>
                    <option value="/ domo">/ domo</option>
                  </select>
                </div>
              </div>

              <!-- Descripción -->
              <div class="form-group">
                <label for="promo-long-desc">Descripción de la Tanda y Receta *</label>
                <textarea id="promo-long-desc" rows="4" required placeholder="Describe la textura, ingredientes especiales, compota, horneado o detalles de conservación..." class="admin-input"></textarea>
              </div>

              <div id="promo-feedback" class="admin-success-msg" style="display: none;"></div>

              <button type="submit" class="btn-publish-promo">
                <span>✨ Guardar y Publicar Tanda</span>
              </button>
            </form>
          </div>
        </section>

        <!-- TAB 3: Gestionar Promociones -->
        <section id="tab-content-manage-promos" class="tab-content" style="display: none;">
          <div class="content-header">
            <h2 class="content-title">Tandas y Catálogo de la Chef</h2>
            <p class="content-desc">Haz clic en <strong>✏️ Modificar</strong> en cualquier tanda para editar sus datos, foto, precio, cupos, fecha de reparto o estado.</p>
          </div>

          <!-- Modal emergente para Modificar Tanda -->
          <div 
            id="edit-tanda-modal" 
            class="admin-modal-overlay" 
            style="display: none;" 
            role="dialog" 
            aria-modal="true" 
            aria-labelledby="edit-tanda-heading"
          >
            <div class="admin-modal-backdrop" id="modal-tanda-backdrop"></div>
            
            <div class="admin-modal-dialog">
              <!-- Header del Modal -->
              <div class="admin-modal-header">
                <div class="modal-title-wrap">
                  <span class="modal-badge-pill">✏️ Modo Edición</span>
                  <h3 class="modal-title" id="edit-tanda-heading">Modificar Tanda</h3>
                  <p class="modal-subtitle">Actualiza los datos, foto, precio, cupos o fecha de reparto</p>
                </div>
                <button type="button" id="btn-cancel-edit" class="btn-modal-close" aria-label="Cerrar modal">
                  ✕
                </button>
              </div>

              <!-- Formulario de Edición dentro del cuerpo del modal -->
              <form id="edit-promo-form" class="admin-modal-form">
                <div class="admin-modal-body">
                  <input type="hidden" id="edit-promo-id" />

                  <!-- Foto de la Tanda -->
                  <div class="form-group photo-upload-group">
                    <label for="edit-image-file">Foto de la Tanda *</label>
                    <div class="photo-upload-zone" id="edit-upload-zone">
                      <input type="file" id="edit-image-file" accept="image/*" class="file-input-hidden" />
                      <input type="hidden" id="edit-image-data" required />
                      <div id="edit-upload-prompt" class="upload-prompt" style="display: none;">
                        <span class="upload-icon">📷</span>
                        <span class="upload-text">Selecciona una foto nueva de tu producto</span>
                        <span class="upload-hint">Haz clic o arrastra una imagen</span>
                      </div>
                      <div id="edit-upload-preview-wrap" class="upload-preview-wrap">
                        <img id="edit-preview-img" src="" alt="Previsualización" class="upload-preview-img" />
                        <button type="button" id="btn-edit-change-photo" class="btn-remove-photo" title="Cambiar foto">✕ Cambiar foto</button>
                      </div>
                    </div>
                    <div class="url-fallback-row">
                      <small>O si tienes un enlace directo a la imagen:</small>
                      <input type="url" id="edit-image-url" placeholder="https://ejemplo.com/foto.jpg" class="admin-input input-sm" />
                    </div>
                    <div class="photo-presets-row">
                      <small>Fotos rápidas sugeridas:</small>
                      <button type="button" class="btn-admin-preset btn-edit-preset" data-img="/images/tarta-vasca.jpg">🍰 Tarta Vasca</button>
                      <button type="button" class="btn-admin-preset btn-edit-preset" data-img="/images/logo.jpeg">🍪 Logo Soft Cookies</button>
                    </div>
                  </div>

                  <!-- Nombre y Subtítulo -->
                  <div class="form-grid-2">
                    <div class="form-group">
                      <label for="edit-promo-name">Nombre de la Tanda / Producto *</label>
                      <input type="text" id="edit-promo-name" required class="admin-input" />
                    </div>

                    <div class="form-group">
                      <label for="edit-promo-subtitle">Subtítulo o Destacado (opcional)</label>
                      <input type="text" id="edit-promo-subtitle" class="admin-input" />
                    </div>
                  </div>

                  <!-- Día de reparto y Cupos -->
                  <div class="form-grid-2">
                    <div class="form-group">
                      <label for="edit-date-picker">Día en que se repartirá *</label>
                      
                      <div 
                        class="calendar-block-trigger" 
                        id="edit-delivery-date-block" 
                        tabindex="0" 
                        role="button" 
                        aria-label="Abrir calendario para cambiar fecha de entrega"
                      >
                        <input 
                          type="date" 
                          id="edit-date-picker" 
                          class="calendar-native-input-overlay" 
                        />

                        <div class="calendar-block-content">
                          <div class="calendar-block-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                              <line x1="16" y1="2" x2="16" y2="6"/>
                              <line x1="8" y1="2" x2="8" y2="6"/>
                              <line x1="3" y1="21" x2="21" y2="10"/>
                              <path d="M8 14h.01"/>
                              <path d="M12 14h.01"/>
                              <path d="M16 14h.01"/>
                              <path d="M8 18h.01"/>
                              <path d="M12 18h.01"/>
                            </svg>
                          </div>

                          <div class="calendar-block-info">
                            <span class="calendar-block-title" id="edit-calendar-title">Seleccionar día</span>
                            <span class="calendar-block-subtitle" id="edit-calendar-subtitle">Haz clic en el bloque para abrir el calendario interactivo</span>
                          </div>
                        </div>
                      </div>

                      <input 
                        type="hidden" 
                        id="edit-promo-dates" 
                        required 
                      />
                      <small class="field-help-text">💡 Todo el bloque abre el calendario interactivo.</small>
                    </div>

                    <div class="form-group">
                      <label for="edit-promo-slots">Total de Cupos Disponibles *</label>
                      <input type="number" id="edit-promo-slots" min="1" required class="admin-input" />
                    </div>
                  </div>

                  <!-- Precio, Unidad y Cupos Reservados -->
                  <div class="form-grid-3">
                    <div class="form-group">
                      <label for="edit-promo-price">Precio ($) *</label>
                      <input type="number" id="edit-promo-price" step="0.50" min="0.50" required class="admin-input" />
                    </div>

                    <div class="form-group">
                      <label for="edit-promo-unit">Unidad de venta</label>
                      <select id="edit-promo-unit" class="admin-input">
                        <option value="/ porción">/ porción</option>
                        <option value="/ unidad">/ unidad</option>
                        <option value="/ box">/ box</option>
                        <option value="/ domo">/ domo</option>
                      </select>
                    </div>

                    <div class="form-group">
                      <label for="edit-reserved-slots">Cupos ya reservados</label>
                      <input type="number" id="edit-reserved-slots" min="0" class="admin-input" />
                    </div>
                  </div>

                  <!-- Descripción -->
                  <div class="form-group">
                    <label for="edit-promo-long-desc">Descripción de la Tanda y Receta *</label>
                    <textarea id="edit-promo-long-desc" rows="4" required class="admin-input"></textarea>
                  </div>

                  <!-- Estado Activa / Pausada -->
                  <div class="form-group">
                    <label for="edit-promo-status">Estado de la Tanda en el Catálogo</label>
                    <select id="edit-promo-status" class="admin-input">
                      <option value="true">🟢 Activa (Visible para reserva en el Inicio)</option>
                      <option value="false">⏸️ Pausada (Oculta del catálogo público)</option>
                    </select>
                  </div>

                  <div id="edit-promo-feedback" class="admin-success-msg" style="display: none;"></div>
                </div>

                <!-- Footer del Modal -->
                <div class="admin-modal-footer">
                  <button type="button" id="btn-cancel-edit-bottom" class="btn-modal-cancel">
                    <span>✕ Cancelar</span>
                  </button>
                  <button type="submit" class="btn-publish-promo btn-save-changes">
                    <span>💾 Guardar Cambios</span>
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- Modal de Confirmación y Alertas con Diseño Artesanal -->
          <div 
            id="admin-confirm-modal" 
            class="admin-modal-overlay" 
            style="display: none;" 
            role="dialog" 
            aria-modal="true" 
            aria-labelledby="confirm-modal-title"
          >
            <div class="admin-modal-backdrop" id="confirm-modal-backdrop"></div>
            <div class="confirm-modal-dialog">
              <div class="confirm-modal-icon-wrap" id="confirm-modal-icon-wrap">
                <span class="confirm-modal-icon" id="confirm-modal-icon">🗑️</span>
              </div>
              <h3 class="confirm-modal-title" id="confirm-modal-title">¿Eliminar esta tanda?</h3>
              <p class="confirm-modal-desc" id="confirm-modal-desc">¿Deseas eliminar esta tanda de la base de datos? Esta acción no se puede deshacer.</p>
              
              <div class="confirm-modal-actions">
                <button type="button" id="confirm-modal-btn-cancel" class="btn-confirm-cancel">
                  Cancelar
                </button>
                <button type="button" id="confirm-modal-btn-action" class="btn-confirm-danger">
                  <span id="confirm-modal-action-text">Sí, Eliminar</span>
                </button>
              </div>
            </div>
          </div>

          <div id="admin-promos-list" class="admin-promos-container"></div>
        </section>

        <!-- TAB 4: Seguridad y Contraseña -->
        <section id="tab-content-security" class="tab-content" style="display: none;">
          <div class="form-container-card" style="max-width: 500px; margin: 0 auto;">
            <div class="form-intro">
              <h2 class="content-title">Cambiar Contraseña de Administradora</h2>
              <p>Modifica la clave de acceso requerida para ingresar a este panel mediante la URL /admin.</p>
            </div>

            <form id="change-pass-form" class="create-promo-form">
              <div class="form-group">
                <label for="new-admin-pass">Nueva Contraseña de Acceso *</label>
                <input 
                  type="password" 
                  id="new-admin-pass" 
                  required 
                  minlength="4" 
                  placeholder="Mínimo 4 caracteres (ej. miClave2026)" 
                  class="admin-input" 
                />
              </div>

              <div id="change-pass-feedback" class="admin-success-msg" style="display: none;"></div>

              <button type="submit" class="btn-publish-promo">
                <span>Guardar Nueva Contraseña</span>
              </button>
            </form>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { getCurrentUser, loginAdminWithPassword, changeAdminPassword, logoutUser, isAdminUser } from '../services/auth';
  import { getAllOrders, updateOrderStatus, getActiveReservedSlotsForProduct } from '../services/orders';
  import { fetchTandasClient, createPromotion, updatePromotion, togglePromotionStatus, deletePromotion } from '../services/promotions';
  import type { Order, Promotion } from '../types';

  const loginView = document.getElementById('admin-login-view') as HTMLElement;
  const dashboardView = document.getElementById('admin-dashboard-view') as HTMLElement;
  const loginForm = document.getElementById('admin-login-form') as HTMLFormElement;
  const loginError = document.getElementById('admin-login-error') as HTMLElement;
  const logoutBtn = document.getElementById('btn-admin-logout') as HTMLElement;

  const metricTotalOrders = document.getElementById('metric-total-orders') as HTMLElement;
  const metricConfirmedOrders = document.getElementById('metric-confirmed-orders') as HTMLElement;
  const metricTotalRevenue = document.getElementById('metric-total-revenue') as HTMLElement;

  const tabButtons = document.querySelectorAll('.admin-nav-tabs .tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  const ordersContainer = document.getElementById('admin-orders-list') as HTMLElement;
  const promosContainer = document.getElementById('admin-promos-list') as HTMLElement;
  const createPromoForm = document.getElementById('create-promo-form') as HTMLFormElement;
  const promoFeedback = document.getElementById('promo-feedback') as HTMLElement;

  // Edit Tanda Modal Elements
  const editTandaModal = document.getElementById('edit-tanda-modal') as HTMLElement;
  const modalTandaBackdrop = document.getElementById('modal-tanda-backdrop') as HTMLElement;
  const editTandaHeading = document.getElementById('edit-tanda-heading') as HTMLElement;
  const editPromoForm = document.getElementById('edit-promo-form') as HTMLFormElement;
  const editPromoId = document.getElementById('edit-promo-id') as HTMLInputElement;
  const editPromoName = document.getElementById('edit-promo-name') as HTMLInputElement;
  const editPromoSubtitle = document.getElementById('edit-promo-subtitle') as HTMLInputElement;
  const editPromoPrice = document.getElementById('edit-promo-price') as HTMLInputElement;
  const editPromoUnit = document.getElementById('edit-promo-unit') as HTMLSelectElement;
  const editPromoSlots = document.getElementById('edit-promo-slots') as HTMLInputElement;
  const editReservedSlots = document.getElementById('edit-reserved-slots') as HTMLInputElement;
  const editPromoDatesInput = document.getElementById('edit-promo-dates') as HTMLInputElement;
  const editPromoLongDesc = document.getElementById('edit-promo-long-desc') as HTMLTextAreaElement;
  const editPromoStatus = document.getElementById('edit-promo-status') as HTMLSelectElement;
