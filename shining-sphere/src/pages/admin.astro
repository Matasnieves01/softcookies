  // Calendar Delivery Date Handlers (Full Block Trigger)
  const datePicker = document.getElementById('promo-date-picker') as HTMLInputElement;
  const dateBlock = document.getElementById('delivery-date-block');
  const calendarTitle = document.getElementById('calendar-block-title');
  const calendarSubtitle = document.getElementById('calendar-block-subtitle');
  const promoDatesInput = document.getElementById('promo-dates') as HTMLInputElement;

  // Set min date to today so the chef cannot accidentally pick past dates
  const todayStr = new Date().toISOString().split('T')[0];
  if (datePicker) datePicker.min = todayStr;

  function formatSpanishDay(dateStr: string): { weekday: string; day: number; month: string; monthNumber: string; year: number } | null {
    if (!dateStr) return null;
    const [y, m, d] = dateStr.split('-').map(Number);
    if (!y || !m || !d) return null;
    const date = new Date(y, m - 1, d);
    const weekdayRaw = date.toLocaleDateString('es-PA', { weekday: 'long' });
    const monthRaw = date.toLocaleDateString('es-PA', { month: 'long' });
    const weekday = weekdayRaw.charAt(0).toUpperCase() + weekdayRaw.slice(1);
    const month = monthRaw.charAt(0).toUpperCase() + monthRaw.slice(1);
    const monthNumber = String(m).padStart(2, '0');
    return { weekday, day: d, month, monthNumber, year: y };
  }

  function handleDateSelected() {
    const val = datePicker?.value;
    if (!val) {
      if (calendarTitle) calendarTitle.textContent = 'Toca aquí para seleccionar día';
      if (calendarSubtitle) calendarSubtitle.textContent = 'Haz clic en cualquier parte del bloque para abrir el calendario';
      dateBlock?.classList.remove('has-selected-date');
      if (promoDatesInput) promoDatesInput.value = '';
      return;
    }

    const info = formatSpanishDay(val);
    if (!info) return;

    const formatted = `${info.weekday} ${info.day} de ${info.month}`;
    if (calendarTitle) calendarTitle.textContent = formatted;
    if (calendarSubtitle) calendarSubtitle.textContent = `Reparto programado para el ${info.day}/${info.monthNumber}/${info.year} • Toca para cambiar`;
    dateBlock?.classList.add('has-selected-date');
    if (promoDatesInput) promoDatesInput.value = formatted;
  }

  function triggerCalendarPicker() {
    if (!datePicker) return;
    try {
      if (typeof datePicker.showPicker === 'function') {
        datePicker.showPicker();
      } else {
        datePicker.focus();
        datePicker.click();
      }
    } catch (err) {
      datePicker.focus();
    }
  }

  // Any click on the input triggers showPicker and prevents double propagation
  datePicker?.addEventListener('click', (e) => {
    e.stopPropagation();
    triggerCalendarPicker();
  });

  // Clicking anywhere on the block opens the calendar
  dateBlock?.addEventListener('click', () => {
    triggerCalendarPicker();
  });

  // Keyboard accessibility: Enter or Space opens the calendar
  dateBlock?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      triggerCalendarPicker();
    }
  });

  datePicker?.addEventListener('change', () => {
    handleDateSelected();
  });

  // Create Promo Form Submit
  createPromoForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const name = (document.getElementById('promo-name') as HTMLInputElement).value;
    const subtitle = (document.getElementById('promo-subtitle') as HTMLInputElement).value;
    const price = parseFloat((document.getElementById('promo-price') as HTMLInputElement).value);
    const unit = (document.getElementById('promo-unit') as HTMLSelectElement).value;
    const totalSlots = parseInt((document.getElementById('promo-slots') as HTMLInputElement).value, 10);
    const batchDates = (document.getElementById('promo-dates') as HTMLInputElement).value;
    const longDescription = (document.getElementById('promo-long-desc') as HTMLTextAreaElement).value;
    const image = (document.getElementById('promo-image-data') as HTMLInputElement).value ||
                  (document.getElementById('promo-image-url') as HTMLInputElement).value;

    if (!batchDates) {
      await showAlertDialog('Por favor selecciona el día de reparto haciendo clic en el bloque del calendario interactivo.', 'Falta Día de Reparto', '📅');
      triggerCalendarPicker();
      return;
    }

    if (!image) {
      await showAlertDialog('Por favor agrega una foto para la tanda (puedes seleccionarla desde tu dispositivo o ingresar un enlace directo).', 'Falta Foto de la Tanda', '📷');
      return;
    }

    try {
      await createPromotion({
        name,
        subtitle,
        price,
        unit,
        totalSlots,
        batchDates,
        shortDescription: longDescription.slice(0, 120),
        longDescription,
        image
      });

      if (promoFeedback) {
        promoFeedback.textContent = '¡Tanda guardada en la base de datos y publicada con éxito!';
        promoFeedback.style.display = 'block';
        setTimeout(() => {
          promoFeedback.style.display = 'none';
          createPromoForm.reset();
          clearPhoto();
          if (datePicker) datePicker.value = '';
          if (promoDatesInput) promoDatesInput.value = '';
          if (calendarTitle) calendarTitle.textContent = 'Toca aquí para seleccionar día';
          if (calendarSubtitle) calendarSubtitle.textContent = 'Haz clic en cualquier parte del bloque para abrir el calendario';
          dateBlock?.classList.remove('has-selected-date');
          // Switch to manage tab
          switchTab('manage-promos');
        }, 1200);
      }
    } catch (err: any) {
      await showAlertDialog(err.message || 'Error al guardar la tanda en la base de datos', 'Error al Guardar', '⚠️');
    }
  });

  // Edit Photo Handlers
  function setEditPhoto(dataUrl: string) {
    if (editPhotoData) editPhotoData.value = dataUrl;
    if (editPreviewImg) editPreviewImg.src = dataUrl;
    if (editUploadPrompt) editUploadPrompt.style.display = 'none';
    if (editPreviewWrap) editPreviewWrap.style.display = 'block';
  }

  editUploadZone?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#btn-edit-change-photo')) return;
    editPhotoFile?.click();
  });

  btnEditChangePhoto?.addEventListener('click', (e) => {
    e.stopPropagation();
    editPhotoFile?.click();
  });

  editPhotoFile?.addEventListener('change', () => {
    const file = editPhotoFile.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      const result = e.target?.result as string;
      if (result) setEditPhoto(result);
    };
    reader.readAsDataURL(file);
  });

  editPhotoUrlInput?.addEventListener('input', () => {
    const url = editPhotoUrlInput.value.trim();
    if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/'))) {
      setEditPhoto(url);
    }
  });

  document.querySelectorAll('.btn-edit-preset').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const img = (btn as HTMLElement).dataset.img;
      if (img) setEditPhoto(img);
    });
  });

  // Edit Calendar Handlers
  function handleEditDateSelected() {
    const val = editDatePicker?.value;
    if (!val) return;
    const info = formatSpanishDay(val);
    if (!info) return;

    const formatted = `${info.weekday} ${info.day} de ${info.month}`;
    if (editCalendarTitle) editCalendarTitle.textContent = formatted;
    if (editCalendarSubtitle) editCalendarSubtitle.textContent = `Reparto programado para el ${info.day}/${info.monthNumber}/${info.year} • Toca para cambiar`;
    editDateBlock?.classList.add('has-selected-date');
    if (editPromoDatesInput) editPromoDatesInput.value = formatted;
  }

  function triggerEditCalendarPicker() {
    if (!editDatePicker) return;
    try {
      if (typeof editDatePicker.showPicker === 'function') {
        editDatePicker.showPicker();
      } else {
        editDatePicker.focus();
        editDatePicker.click();
      }
    } catch {
      editDatePicker.focus();
    }
  }

  editDatePicker?.addEventListener('click', (e) => {
    e.stopPropagation();
    triggerEditCalendarPicker();
  });

  editDateBlock?.addEventListener('click', () => {
    triggerEditCalendarPicker();
  });

  editDateBlock?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      triggerEditCalendarPicker();
    }
  });

  editDatePicker?.addEventListener('change', () => {
    handleEditDateSelected();
  });

  // Edit Promo Form Submit
  editPromoForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = editPromoId.value;
    if (!id) return;

    const name = editPromoName.value.trim();
    const subtitle = editPromoSubtitle.value.trim();
    const price = parseFloat(editPromoPrice.value);
    const unit = editPromoUnit.value;
    const totalSlots = parseInt(editPromoSlots.value, 10);
    const currentPromo = allLoadedPromos.find((p) => p.id === id);
    const activeOrderSlots = getActiveReservedSlotsForProduct(id, name, currentPromo?.slug, allLoadedPromos.length);
    const inputReserved = parseInt(editReservedSlots.value, 10);
    const reservedSlots = isNaN(inputReserved) ? activeOrderSlots : Math.max(inputReserved, activeOrderSlots);
    const batchDates = editPromoDatesInput.value.trim();
    const longDescription = editPromoLongDesc.value.trim();
    const image = editPhotoData.value || editPhotoUrlInput.value.trim();
    const isActive = editPromoStatus.value === 'true';

    if (!batchDates) {
      await showAlertDialog('Por favor selecciona la fecha de entrega en el bloque del calendario interactivo.', 'Falta Fecha de Entrega', '📅');
      triggerEditCalendarPicker();
      return;
    }

    if (!image) {
      await showAlertDialog('Por favor selecciona o ingresa una foto para la tanda.', 'Falta Foto de la Tanda', '📷');
      return;
    }

    try {
      await updatePromotion(id, {
        name,
        subtitle,
        price,
        unit,
        totalSlots,
        reservedSlots,
        batchDates,
        deliveryDate: batchDates,
        shortDescription: longDescription.slice(0, 120),
        longDescription,
        image,
        isActive
      });

      if (editPromoFeedback) {
        editPromoFeedback.textContent = `¡Tanda "${name}" actualizada con éxito en la base de datos!`;
        editPromoFeedback.style.display = 'block';
        setTimeout(() => {
          editPromoFeedback.style.display = 'none';
          closeEditTanda();
          renderPromotions();
        }, 1200);
      }
    } catch (err: any) {
      await showAlertDialog(err.message || 'Error al actualizar la tanda en la base de datos', 'Error al Actualizar', '⚠️');
    }
  });

  // Toggle pass visibility
  const togglePassBtn = document.getElementById('btn-toggle-pass');
  togglePassBtn?.addEventListener('click', () => {
    const passInput = document.getElementById('admin-pass') as HTMLInputElement;
    if (passInput) {
      passInput.type = passInput.type === 'password' ? 'text' : 'password';
    }
  });

  // Admin Login Handle
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (loginError) {
      loginError.style.display = 'none';
      loginError.textContent = '';
    }
    const passInput = document.getElementById('admin-pass') as HTMLInputElement;
    const pass = passInput?.value || '';

    try {
      loginAdminWithPassword(pass);
      initAdmin();
    } catch (err: any) {
      if (loginError) {
        loginError.textContent = err.message || 'Contraseña incorrecta';
        loginError.style.display = 'block';
      }
    }
  });

  // Change Password Handle
  const changePassForm = document.getElementById('change-pass-form') as HTMLFormElement;
  const changePassFeedback = document.getElementById('change-pass-feedback') as HTMLElement;
  changePassForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPassInput = document.getElementById('new-admin-pass') as HTMLInputElement;
    const newPass = newPassInput?.value || '';

    try {
      changeAdminPassword(newPass);
      if (changePassFeedback) {
        changePassFeedback.textContent = '¡Contraseña actualizada con éxito!';
        changePassFeedback.style.display = 'block';
        setTimeout(() => {
          changePassFeedback.style.display = 'none';
          changePassForm.reset();
        }, 2500);
      }
    } catch (err: any) {
      await showAlertDialog(err.message || 'Error al actualizar la contraseña', 'Error de Contraseña', '🔐');
    }
  });

  logoutBtn?.addEventListener('click', () => {
    logoutUser();
    window.location.href = '/';
  });

  // Start
  initAdmin();
</script>

