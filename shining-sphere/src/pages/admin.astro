  async function renderPromotions() {
    if (!promosContainer) return;
    try {
      const promos = await fetchTandasClient(true);
      allLoadedPromos = promos;

      if (promos.length === 0) {
        closeEditTanda();
        promosContainer.innerHTML = `
          <div class="empty-admin-box">
            <p>No hay tandas registradas aún. Haz clic en 'Crear Nueva Tanda' para publicar la primera tanda en el catálogo.</p>
          </div>
        `;
        return;
      }

      promosContainer.innerHTML = promos
        .map((p) => {
          const isSelected = p.id === selectedTandaId;
          const activeOrderSlots = getActiveReservedSlotsForProduct(p.id, p.name, p.slug, promos.length);
          const effectiveReserved = Math.max(p.reservedSlots || 0, activeOrderSlots);
          const remaining = Math.max(0, p.totalSlots - effectiveReserved);
          const isSoldOut = remaining <= 0;
          const progressPercent = isSoldOut ? 100 : Math.min(100, Math.round((effectiveReserved / p.totalSlots) * 100));

          return `
            <div class="admin-promo-card ${isSelected ? 'is-selected' : ''}" data-id="${p.id}">
              <!-- Contenedor Visual de Foto -->
              <div class="promo-card-visual">
                <img src="${p.image}" alt="${p.name}" />
                <span class="promo-badge-overlay ${!p.isActive ? 'badge-paused' : isSoldOut ? 'badge-soldout' : 'badge-active'}">
                  ${!p.isActive ? '⏸️ Pausada' : isSoldOut ? '🚫 Agotada' : '● Activa'}
                </span>
              </div>

              <!-- Contenido Completo de la Tanda -->
              <div class="promo-card-body">
                <div class="promo-main-meta">
                  <div class="promo-header-line">
                    <h3 class="promo-title">${p.name}</h3>
                  </div>
                  ${p.subtitle ? `<p class="promo-subtitle">${p.subtitle}</p>` : ''}
                  <p class="promo-desc">${p.longDescription || p.shortDescription || 'Sin descripción detallada.'}</p>
                  
                  <!-- Badges de Información Clave -->
                  <div class="promo-meta-chips">
                    <div class="meta-chip chip-price">
                      <span>💰 $${Number(p.price).toFixed(2)} ${p.unit || '/ porción'}</span>
                    </div>
                    <div class="meta-chip chip-date">
                      <span>📅 Reparto: ${p.deliveryDate || p.batchDates || 'Por definir'}</span>
                    </div>
                    <div class="meta-chip chip-slots ${isSoldOut ? 'chip-slots-soldout' : ''}">
                      <span>${isSoldOut ? `🚫 ${p.totalSlots}/${p.totalSlots} Agotada (0 libres)` : `🔥 ${effectiveReserved}/${p.totalSlots} reservados (${remaining} libres)`}</span>
                    </div>
                  </div>

                  <!-- Barra de progreso de cupos -->
                  <div class="promo-slots-progress-wrap">
                    <div class="promo-slots-progress" title="${progressPercent}% de cupos reservados">
                      <div class="promo-slots-fill" style="width: ${progressPercent}%;"></div>
                    </div>
                  </div>
                </div>

                <!-- Botones de Acción -->
                <div class="promo-card-actions">
                  <button type="button" class="btn-edit-tanda" data-id="${p.id}" title="Modificar datos, precio, cupos o foto de esta tanda">
                    <span>✏️ Editar Tanda</span>
                  </button>
                  <button type="button" class="btn-toggle-promo ${p.isActive ? 'btn-status-pause' : 'btn-status-active'}" data-id="${p.id}">
                    ${p.isActive ? '⏸️ Pausar Tanda' : '▶️ Activar en Catálogo'}
                  </button>
                  <button type="button" class="btn-delete-promo" data-id="${p.id}" title="Eliminar tanda permanentemente">
                    🗑️ Eliminar
                  </button>
                </div>
              </div>
            </div>
          `;
        })
        .join('');

      promosContainer.querySelectorAll('.btn-edit-tanda').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          openEditTanda(id);
        });
      });

      promosContainer.querySelectorAll('.admin-promo-card').forEach((card) => {
        card.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('button')) return;
          const id = (card as HTMLElement).dataset.id!;
          openEditTanda(id);
        });
      });

      promosContainer.querySelectorAll('.btn-toggle-promo').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          await togglePromotionStatus(id);
          renderPromotions();
        });
      });

      promosContainer.querySelectorAll('.btn-delete-promo').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = (e.currentTarget as HTMLElement).dataset.id!;
          const tanda = allLoadedPromos.find((p) => p.id === id);
          const tandaName = tanda ? `"${tanda.name}"` : 'esta tanda';

          const confirmed = await showConfirmDialog({
            title: '¿Eliminar tanda del catálogo?',
            message: `¿Deseas eliminar permanentemente la tanda <strong>${tandaName}</strong> de la base de datos? Esta acción no se puede deshacer.`,
            confirmText: 'Sí, Eliminar',
            cancelText: 'Cancelar',
            isDanger: true,
            icon: '🗑️'
          });

          if (confirmed) {
            await deletePromotion(id);
            if (selectedTandaId === id) closeEditTanda();
            renderPromotions();
          }
        });
      });
    } catch (err) {
      console.error('Error rendering tandas:', err);
    }
  }

