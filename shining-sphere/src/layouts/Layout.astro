---
import '../styles/global.css';
import AuthModal from '../components/AuthModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Soft Cookies TANDAS | Bakehouse Artesanal",
  description = "Horneadas exclusivas por tanda y promociones especiales de Soft Cookies por la chef @chelsea.mhm en Tierras Altas, Bugaba y David."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <link rel="apple-touch-icon" href="/images/logo.jpeg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fef9f1" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />
    <AuthModal />
  </body>
</html>
